<package format="3">
  <name>controller</name>
  <version>0.2.0</version>
  <description>Pure Pursuit trajectory tracking with PID speed control for a kinematic bicycle model in CARLA.</description>
  <maintainer email="abdelrhman.aldesoky@outlook.com">Abdelrahman Eldesouky</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>carla_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>planning_msgs</depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>